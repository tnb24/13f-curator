# Copy to .env and fill in. .env is gitignored.
#
# agents/llm.py reads these values. Any OpenAI-compatible endpoint works:
#
#   Ollama:      LLM_BASE_URL=http://localhost:11434/v1
#   LM Studio:   LLM_BASE_URL=http://localhost:1234/v1
#   vLLM:        LLM_BASE_URL=http://localhost:8000/v1
#   OpenRouter:  LLM_BASE_URL=https://openrouter.ai/api/v1  (LLM_MODEL is required)
#
# The evals in evals/results/ used google/gemma-4-31b-it on OpenRouter.

LLM_BASE_URL=http://localhost:11434/v1
LLM_API_KEY=not-required

# Leave blank to use the first model that the endpoint lists.
LLM_MODEL=

# "mock" returns fixed replies and contacts no endpoint.
LLM_MODE=live

# Stop after provider-reported usage reaches this per-process threshold. A call
# can exceed it, and providers that omit token usage cannot be tracked.
LLM_TOKEN_BUDGET=2000000
